# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://traceback:traceback@localhost:5432/traceback

# Auth (required in production; dev falls back to a well-known local secret)
JWT_ACCESS_SECRET=change-me-dev-access-secret-32chars
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-32chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Web
CORS_ORIGIN=http://localhost:3000

# Events: an occurred_at older than now - threshold is flagged is_late
LATE_EVENT_THRESHOLD_MS=300000

# GitHub webhook HMAC secret (optional locally)
GITHUB_WEBHOOK_SECRET=

RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
