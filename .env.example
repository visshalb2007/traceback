# docker-compose overrides. Copy to `.env` and edit.

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Auth (REQUIRED in production — generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-dev-access-secret-32chars
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-32chars

# GitHub webhook HMAC secret
GITHUB_WEBHOOK_SECRET=
