# Copy to .env for local development: `cp .env.example .env`
# Every value below has a working default, so a fresh clone can run without this file.

# --- API ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres. The docker-compose `db` service matches these credentials.
DATABASE_URL=postgres://traceback:traceback@localhost:5432/traceback
DATABASE_POOL_MAX=10

# Required in production; development/test fall back to local defaults.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

CORS_ORIGIN=http://localhost:3000
LATE_EVENT_THRESHOLD_MS=300000
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute

# Reserved for docker-compose. Webhook signing secrets are configured per
# endpoint in the app (Settings -> Webhooks), not from the environment.
GITHUB_WEBHOOK_SECRET=

# --- Tests -------------------------------------------------------------------
# Set to run the integration suites against the throwaway database on :5433.
# TEST_DATABASE_URL=postgres://traceback:traceback@localhost:5433/traceback_test

# --- Web ---------------------------------------------------------------------
# Baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
